{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "react"]
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "services/**/*.ts"],
  "exclude": ["node_modules", "packages/api-contract/legacy"]
}
