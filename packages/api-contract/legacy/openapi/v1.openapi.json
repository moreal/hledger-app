{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "hledger-app API",
    "version": "1.0.0-draft",
    "description": "앱(웹/모바일)이 안정적으로 사용할 v1 계약 API 초안입니다. hledger-web raw 응답을 서버 내부에서 정규화해 제공하는 것을 전제로 합니다."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "로컬 개발 서버"
    }
  ],
  "tags": [
    {
      "name": "system",
      "description": "상태/운영"
    },
    {
      "name": "accounts",
      "description": "계정 조회"
    },
    {
      "name": "transactions",
      "description": "거래 조회/입력"
    },
    {
      "name": "prices",
      "description": "시세 조회"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "API 상태 확인",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "API 및 인덱서가 정상 상태",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "API는 동작하지만 의존성(인덱서/원장 접근)이 저하된 상태",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/accounts": {
      "get": {
        "tags": [
          "accounts"
        ],
        "summary": "계정 목록 조회",
        "operationId": "listAccounts",
        "parameters": [
          {
            "$ref": "#/components/parameters/IncludeEmpty"
          },
          {
            "$ref": "#/components/parameters/Depth"
          },
          {
            "$ref": "#/components/parameters/AsOfDate"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "계정 요약 목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountListResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 파라미터",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/accounts/{accountId}/transactions": {
      "get": {
        "tags": [
          "accounts",
          "transactions"
        ],
        "summary": "특정 계정의 거래 목록 조회",
        "operationId": "listAccountTransactions",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "계정 식별자(예: assets:cash)",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "$ref": "#/components/parameters/FromDate"
          },
          {
            "$ref": "#/components/parameters/ToDate"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "거래 목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionListResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 파라미터",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "계정을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/transactions": {
      "get": {
        "tags": [
          "transactions"
        ],
        "summary": "거래 목록 조회",
        "operationId": "listTransactions",
        "parameters": [
          {
            "$ref": "#/components/parameters/Query"
          },
          {
            "$ref": "#/components/parameters/FromDate"
          },
          {
            "$ref": "#/components/parameters/ToDate"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "거래 목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionListResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 파라미터",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "transactions"
        ],
        "summary": "신규 거래 생성",
        "operationId": "createTransaction",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "동일 요청 재전송 시 중복 생성을 방지하는 멱등 키",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransactionCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionCreateResponse"
                }
              }
            }
          },
          "400": {
            "description": "입력 검증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "중복 요청 충돌 또는 비즈니스 충돌",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/prices": {
      "get": {
        "tags": [
          "prices"
        ],
        "summary": "시세 목록 조회",
        "operationId": "listPrices",
        "parameters": [
          {
            "$ref": "#/components/parameters/Commodity"
          },
          {
            "$ref": "#/components/parameters/FromDate"
          },
          {
            "$ref": "#/components/parameters/ToDate"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "시세 목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceListResponse"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 파라미터",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "FromDate": {
        "name": "from",
        "in": "query",
        "required": false,
        "description": "조회 시작일(포함), YYYY-MM-DD",
        "schema": {
          "type": "string",
          "format": "date"
        }
      },
      "ToDate": {
        "name": "to",
        "in": "query",
        "required": false,
        "description": "조회 종료일(포함), YYYY-MM-DD",
        "schema": {
          "type": "string",
          "format": "date"
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "다음 페이지 조회용 커서",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "페이지당 항목 수 (기본 50)",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      },
      "Query": {
        "name": "query",
        "in": "query",
        "required": false,
        "description": "자유 검색어(설명, 계정, 태그 등)",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "Commodity": {
        "name": "commodity",
        "in": "query",
        "required": false,
        "description": "조회 대상 상품/통화 심볼 (예: USD, BTC, $)",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "IncludeEmpty": {
        "name": "include_empty",
        "in": "query",
        "required": false,
        "description": "잔액이 0인 계정도 포함할지 여부",
        "schema": {
          "type": "boolean",
          "default": false
        }
      },
      "Depth": {
        "name": "depth",
        "in": "query",
        "required": false,
        "description": "계정 계층 깊이 제한",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "AsOfDate": {
        "name": "as_of",
        "in": "query",
        "required": false,
        "description": "기준일 잔액 조회, YYYY-MM-DD",
        "schema": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "timestamp",
          "version",
          "indexer_lag_seconds"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "indexer_lag_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "request_id",
          "timestamp"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MoneyAmount": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commodity",
          "value"
        ],
        "properties": {
          "commodity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "value": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          }
        }
      },
      "CursorPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "next_cursor",
          "has_more",
          "limit"
        ],
        "properties": {
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "total_estimate": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "TagMap": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "AccountSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "full_name",
          "depth",
          "balances",
          "transaction_count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "full_name": {
            "type": "string",
            "minLength": 1
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "balances": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/MoneyAmount"
            }
          },
          "transaction_count": {
            "type": "integer",
            "minimum": 0
          },
          "last_posted_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "tags": {
            "$ref": "#/components/schemas/TagMap"
          }
        }
      },
      "AccountListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountSummary"
            }
          },
          "page": {
            "$ref": "#/components/schemas/CursorPage"
          }
        }
      },
      "Posting": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account_name",
          "amount"
        ],
        "properties": {
          "account_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "account_name": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "$ref": "#/components/schemas/MoneyAmount"
          },
          "memo": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        }
      },
      "Transaction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "description",
          "status",
          "postings",
          "tags",
          "created_at",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "code": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "status": {
            "type": "string",
            "enum": [
              "unmarked",
              "pending",
              "cleared"
            ]
          },
          "postings": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/components/schemas/Posting"
            }
          },
          "tags": {
            "$ref": "#/components/schemas/TagMap"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "enum": [
              "hledger",
              "app"
            ]
          }
        }
      },
      "TransactionListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            }
          },
          "page": {
            "$ref": "#/components/schemas/CursorPage"
          }
        }
      },
      "PostingInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account_name",
          "amount"
        ],
        "properties": {
          "account_name": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "$ref": "#/components/schemas/MoneyAmount"
          },
          "memo": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        }
      },
      "TransactionCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "description",
          "postings"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "code": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "postings": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/components/schemas/PostingInput"
            }
          },
          "tags": {
            "$ref": "#/components/schemas/TagMap"
          },
          "client_reference": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          }
        }
      },
      "IdempotencyInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "replayed"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "replayed": {
            "type": "boolean"
          }
        }
      },
      "TransactionCreateResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transaction",
          "idempotency"
        ],
        "properties": {
          "transaction": {
            "$ref": "#/components/schemas/Transaction"
          },
          "idempotency": {
            "$ref": "#/components/schemas/IdempotencyInfo"
          }
        }
      },
      "PriceQuote": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commodity",
          "quote_commodity",
          "date",
          "rate"
        ],
        "properties": {
          "commodity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "quote_commodity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "rate": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          }
        }
      },
      "PriceListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceQuote"
            }
          },
          "page": {
            "$ref": "#/components/schemas/CursorPage"
          }
        }
      }
    }
  }
}
