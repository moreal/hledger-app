{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hledger-app.local/schemas/account-list.response.schema.json",
  "title": "GET /v1/accounts response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "page"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AccountSummary"
      }
    },
    "page": {
      "$ref": "./common.schema.json#/$defs/CursorPage"
    }
  },
  "$defs": {
    "AccountSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "full_name",
        "depth",
        "balances",
        "transaction_count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "full_name": {
          "type": "string",
          "minLength": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "balances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "./common.schema.json#/$defs/MoneyAmount"
          }
        },
        "transaction_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_posted_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "tags": {
          "$ref": "./common.schema.json#/$defs/TagMap"
        }
      }
    }
  }
}
