{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hledger-app.local/schemas/common.schema.json",
  "title": "hledger-app v1 Common Types",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "MoneyAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commodity",
        "value"
      ],
      "properties": {
        "commodity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "value": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        }
      }
    },
    "CursorPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_cursor",
        "has_more",
        "limit"
      ],
      "properties": {
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "has_more": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "total_estimate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "TagMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "request_id",
        "timestamp"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "IdempotencyInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "replayed"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "replayed": {
          "type": "boolean"
        }
      }
    }
  }
}
